PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Store subscriptions are billed annually and mocked server-side (see
# POST /api/stores/subscribe) -- no real payment processor is wired in yet.
# Wire in Stripe Billing (or similar) there before charging real money.

# Customer order payments (UPI/netbanking/cards) go through Razorpay.
# Get Test Mode keys free, instantly, no KYC required, at:
# dashboard.razorpay.com -> Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

