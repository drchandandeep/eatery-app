{
  "expo": {
    "name": "Kahumbo",
    "slug": "kahumbo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#171512"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.kahumbo"
    },
    "android": {
      "package": "com.yourcompany.kahumbo",
      "adaptiveIcon": {
        "backgroundColor": "#171512"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
