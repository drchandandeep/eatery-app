PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Store subscriptions (Rs 60,000/year, +10% each renewal) are paid via the
# platform's own UPI QR code, not a payment gateway. The store owner
# uploads a payment screenshot in the app; a platform_admin account reviews
# and approves it from the "Approvals" tab (see routes/platform.js and
# routes/stores.js). No env vars are needed for this -- the QR image itself
# is uploaded once from inside the app (or the /admin web page) by a
# platform_admin and stored in the database.

# Customer order payments also don't use a payment gateway. Each store
# owner uploads their own UPI QR code from their Admin dashboard
# (PATCH /api/stores/me -- order_qr_image_base64, order_upi_id), which is
# shown to customers at checkout as a "Pay via Store QR" option, alongside
# Cash on Delivery (Cash/UPI paid in person). Neither payment method is
# automatically verified server-side -- the store owner confirms receipt
# themselves when advancing an order's status. No env vars needed here.

# Order confirmation emails (optional). If any of these are left unset,
# emails are silently skipped -- everything else keeps working normally.
# For Gmail: use smtp.gmail.com, port 587, and a 16-character Google
# "App Password" (not your normal Gmail password) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=youraddress@gmail.com
