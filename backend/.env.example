PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Store subscriptions (Rs 50,000/year) are paid via the platform's own UPI
# QR code, not a payment gateway. The store owner uploads a payment
# screenshot in the app; a platform_admin account reviews and approves it
# from the "Approvals" tab (see routes/platform.js and routes/stores.js).
# No env vars are needed for this -- the QR image itself is uploaded once
# from inside the app by a platform_admin and stored in the database.

# Customer order payments (UPI/netbanking/cards) go through Razorpay.
# Get Test Mode keys free, instantly, no KYC required, at:
# dashboard.razorpay.com -> Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Order confirmation emails (optional). If any of these are left unset,
# emails are silently skipped -- everything else keeps working normally.
# For Gmail: use smtp.gmail.com, port 587, and a 16-character Google
# "App Password" (not your normal Gmail password) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=youraddress@gmail.com
