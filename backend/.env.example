# Copy this file to .env and fill in your real values.
# .env itself should NEVER be committed to GitHub (it should already be
# in .gitignore) -- it holds secrets.

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# ---- Database (Turso) ----
# Get these two values from your Turso dashboard/CLI for your database
# (e.g. kahumbo-chandandeep). Both are required for the app to use Turso.
# If both are left blank, the app falls back to a local file at
# db/kahumbo.db -- fine for testing on your own laptop, but that file is
# NOT persistent on Render's free tier, so production must set these two.
TURSO_DATABASE_URL=libsql://kahumbo-chandandeep.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=paste-your-turso-auth-token-here

# ---- Email (optional, for order/OTP notification emails) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
